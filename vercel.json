{
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "Permissions-Policy", "value": "camera=(self)" } ] },
    { "source": "/vendor/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
